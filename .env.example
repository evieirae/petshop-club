# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no dashboard do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings > API > service_role) — NUNCA prefixar
# com NEXT_PUBLIC_, e um secret de servidor. Usada so em
# lib/supabase/admin.ts, pro formulario publico de autopreenchimento de
# tutor (app/(public)/cadastro/[tutorId]) conseguir gravar em tutores/pets
# sem sessao logada (RLS exige auth_petshop_id(), que so existe pra equipe
# autenticada — ver Fase 3 do ROADMAP.md e secao 6 de
# docs/regras_padrao_petshop.md).
SUPABASE_SERVICE_ROLE_KEY=

# Senha de primeiro acesso do tutor no portal (/minha-conta), migration 0024.
# SETADA  -> todo tutor liberado nasce com ESTA senha (decisao de 31/ago/2026:
#            mais facil de ditar no balcao e mandar no WhatsApp).
# VAZIA   -> cada tutor nasce com uma senha aleatoria, mostrada uma vez na
#            tela da administracao. Mesmo comportamento que o dono de petshop
#            ja tem. E o modo mais seguro, e trocar pra ele NAO exige deploy
#            de codigo nem migration: basta apagar esta variavel.
#
# O risco de deixar setada esta escrito por extenso no fim de
# supabase/migrations/0024_portal_tutor_acesso.sql. Resumo: e-mail de tutor
# nao e segredo, entao quem souber o padrao entra na conta de qualquer tutor
# que ainda nao trocou a senha. O que segura isso: acesso liberado um a um,
# validade de 72h e troca obrigatoria no primeiro login.
#
# Minimo de 6 caracteres (exigencia do Supabase Auth); abaixo disso o codigo
# ignora e cai no modo aleatorio.
TUTOR_SENHA_PADRAO=

# Fase 5 (lembretes automaticos via WhatsApp Cloud API da Meta) — as Edge
# Functions supabase/functions/{enviar-lembretes,whatsapp-webhook} NAO leem
# .env.local (rodam em Deno, na infra do Supabase, nao no Next.js).
# Configure essas credenciais via CLI:
#
#   supabase secrets set \
#     META_PHONE_NUMBER_ID=<id do numero no WhatsApp Manager, nao o telefone> \
#     META_ACCESS_TOKEN=<token permanente de System User> \
#     META_APP_SECRET=<App Secret do app da Meta> \
#     META_WEBHOOK_VERIFY_TOKEN=<valor-aleatorio que voce escolhe> \
#     META_GRAPH_VERSION=v21.0 \
#     APP_BASE_URL=https://seu-dominio \
#     CRON_SECRET=<valor-aleatorio>
#
# Cada um serve pra:
#   META_PHONE_NUMBER_ID     — destino da chamada POST .../{id}/messages
#   META_ACCESS_TOKEN        — Bearer token; token de usuario expira em 24h,
#                              use o permanente de System User com a
#                              permissao whatsapp_business_messaging
#   META_APP_SECRET          — valida o HMAC X-Hub-Signature-256 do webhook
#                              (a rota e publica na internet; sem isso
#                              qualquer um forja status de entrega)
#   META_WEBHOOK_VERIFY_TOKEN— confere o hub.verify_token da chamada GET que
#                              a Meta faz ao cadastrar a URL do webhook
#   META_GRAPH_VERSION       — versao do Graph API; fixa de proposito
#
# CRON_SECRET tambem precisa ser setado no Postgres (uma vez, fora de
# qualquer migration versionada), pro pg_cron autenticar a chamada:
#
#   alter database postgres set app.cron_secret = '<mesmo-valor-aleatorio>';
#
# Os templates precisam estar APROVADOS na Meta antes do primeiro envio —
# ver docs/whatsapp_templates_meta.md e o checklist operacional completo em
# ROADMAP.md, Fase 5.

# E-mails transacionais de acesso (convite + senha temporária + reset) —
# ver lib/email/. Diferente das credenciais da Meta (Fase 5), estas SÃO
# lidas do .env.local/Vercel, porque quem chama é app/(admin)/admin/actions.ts
# (Server Action do Next, roda em Node), não uma Edge Function em Deno.
#
# RESEND_API_KEY vazia -> os e-mails de convite/reset simplesmente não saem
# (fica logado no servidor), e a senha continua aparecendo na tela do admin
# como sempre apareceu. Nenhum fluxo existente quebra por falta desta env.
#
#   1. Crie uma conta em resend.com e verifique um domínio (SPF/DKIM/DMARC —
#      o próprio Resend gera os registros DNS pra copiar).
#   2. Gere uma API key e cole abaixo.
#   3. EMAIL_REMETENTE precisa usar esse domínio verificado, formato
#      "Nome <endereco@dominio>".
RESEND_API_KEY=
EMAIL_REMETENTE="Clube de Banho e Tosa <notificacoes@seu-dominio.com.br>"

# URL pública do app, pra montar link de login/cadastro dentro dos e-mails
# (roda no servidor, não dá pra usar window.location.origin). Em produção
# na Vercel, deixe vazia e o código cai em VERCEL_URL automaticamente; só
# precisa preencher se o domínio de produção for diferente do domínio da
# Vercel (ex.: domínio próprio configurado como padrão).
NEXT_PUBLIC_APP_URL=
