# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no dashboard do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings > API > service_role) — NUNCA prefixar
# com NEXT_PUBLIC_, e um secret de servidor. Usada so em
# lib/supabase/admin.ts, pro formulario publico de autopreenchimento de
# tutor (app/(public)/cadastro/[tutorId]) conseguir gravar em tutores/pets
# sem sessao logada (RLS exige auth_petshop_id(), que so existe pra equipe
# autenticada — ver Fase 3 do ROADMAP.md e secao 6 de
# docs/regras_padrao_petshop.md).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 5 (lembretes automaticos via WhatsApp Cloud API da Meta) — as Edge
# Functions supabase/functions/{enviar-lembretes,whatsapp-webhook} NAO leem
# .env.local (rodam em Deno, na infra do Supabase, nao no Next.js).
# Configure essas credenciais via CLI:
#
#   supabase secrets set \
#     META_PHONE_NUMBER_ID=<id do numero no WhatsApp Manager, nao o telefone> \
#     META_ACCESS_TOKEN=<token permanente de System User> \
#     META_APP_SECRET=<App Secret do app da Meta> \
#     META_WEBHOOK_VERIFY_TOKEN=<valor-aleatorio que voce escolhe> \
#     META_GRAPH_VERSION=v21.0 \
#     APP_BASE_URL=https://seu-dominio \
#     CRON_SECRET=<valor-aleatorio>
#
# Cada um serve pra:
#   META_PHONE_NUMBER_ID     — destino da chamada POST .../{id}/messages
#   META_ACCESS_TOKEN        — Bearer token; token de usuario expira em 24h,
#                              use o permanente de System User com a
#                              permissao whatsapp_business_messaging
#   META_APP_SECRET          — valida o HMAC X-Hub-Signature-256 do webhook
#                              (a rota e publica na internet; sem isso
#                              qualquer um forja status de entrega)
#   META_WEBHOOK_VERIFY_TOKEN— confere o hub.verify_token da chamada GET que
#                              a Meta faz ao cadastrar a URL do webhook
#   META_GRAPH_VERSION       — versao do Graph API; fixa de proposito
#
# CRON_SECRET tambem precisa ser setado no Postgres (uma vez, fora de
# qualquer migration versionada), pro pg_cron autenticar a chamada:
#
#   alter database postgres set app.cron_secret = '<mesmo-valor-aleatorio>';
#
# Os templates precisam estar APROVADOS na Meta antes do primeiro envio —
# ver docs/whatsapp_templates_meta.md e o checklist operacional completo em
# ROADMAP.md, Fase 5.
